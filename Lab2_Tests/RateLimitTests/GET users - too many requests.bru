meta {
  name: GET users - too many requests
  type: http
  seq: 1
}

get {
  url: {{baseURL}}/api/users
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer lab2_secret_key
}

script:pre-request {
  //AI Use Statement: ChatGPT was used to resolve a bug in this script.
  for (let i = 0; i < 100; i++) {
    await bru.sendRequest({
      url: "http://localhost:3000/api/users",
      method: 'GET',
      headers: {
      Authorization: "Bearer lab2_secret_key"
    }
    });
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
